[Unit]
Description=Hermes DataAgent service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/application
EnvironmentFile=/etc/hermes/data-service.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/application/src/utils/src:/opt/application/src/website_agent/src
ExecStart=/opt/application/venv/bin/python3 /opt/application/src/data_service.py
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
