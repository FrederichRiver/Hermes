# Django 设置
DJANGO_SECRET_KEY=replace_me_with_a_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 数据库连接设置 (通过 Docker Network 访问 MySQL 容器)
# 这里的 DB_HOST 应该填写 MySQL 容器的名称（如果在同一网络下）或者 IP
DB_HOST=mysql_server
DB_PORT=3306
DB_NAME=mydb
DB_USER=appuser
DB_PASSWORD=apppassword